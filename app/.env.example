# --- GitHub source repo (content-only repo that drives this site) ---
GITHUB_REPO=Reinvy/ReinvyLibrary
GITHUB_BRANCH=main

# Optional: personal access token — raises GitHub API rate limit (60/hr → 5000/hr).
# Not required: raw.githubusercontent.com is a CDN (no rate limit) and the tree
# is fetched once per revalidate window.
# GITHUB_TOKEN=

# ISR revalidate window in seconds (default 300 = 5 minutes)
ISR_REVALIDATE=300

# Public site URL used for canonical/OG links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
